APP_NAME=EduTrace
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./edutrace.db
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
MAX_UPLOAD_MB=15
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Optional production PostgreSQL
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edutrace

# Optional LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OCR path; leave blank if tesseract is already on PATH
TESSERACT_CMD=

# ML
MODEL_PATH=storage/processed/gap_model.joblib
